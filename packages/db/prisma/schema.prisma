// =============================================================================
// ATELIER — Prisma-схема MVP (финал после ревью)
// PostgreSQL. Источник истины по продукту: docs/04-product-spec.md
// Пояснения, state machine заказа, инварианты и решения ревью: docs/11-data-model.md
//
// Конвенции:
// - Деньги: Int в СОМАХ (KGS), целые. Тыйыны (minor units) не нужны —
//   на рынке нет цен с дробными сомами, все бюджеты/вилки оперируют
//   тысячами сомов. USD — только отображение по курсу НБКР (ExchangeRate).
// - Везде createdAt/updatedAt; deletedAt = soft-delete там, где контент
//   может ссылаться извне (кейсы, коллекции, сообщения и т.п.).
// - enum-значения — английские; локализация — в i18n-слое.
// - Никаких кредитных/процентных механик — в схеме их нет и не будет.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // native — для локали и билд-образа Vercel (Amazon Linux); rhel-openssl-3.0.x —
  // рантайм serverless-функции (AWS Lambda). Страховка от дрейфа build-образа.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // рантайм — пул-строка транзакционного пулера (serverless открывает много коннектов)
  url      = env("DATABASE_URL")
  // прямое session-mode соединение для миграций (migrate deploy через pgBouncer
  // виснет на advisory-lock/prepared statements). В dev DIRECT_URL = тот же URL.
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ПОЛЬЗОВАТЕЛИ И ПРОФИЛИ
// =============================================================================

enum UserRole {
  CLIENT
  SPECIALIST
  MODERATOR
  ADMIN
}

/// Trust-tiers модерации (решение 03/4): новичок — премодерация первых 3 кейсов.
enum TrustTier {
  NEW
  TRUSTED
  VERIFIED
}

model User {
  id String @id @default(cuid())
  /// Телефон E.164 (+996XXXXXXXXX). NULLABLE: Google-вход создаёт аккаунт без
  /// телефона; действия ценности (заявка/бриф/заказ) требуют phoneVerifiedAt
  /// (ревю-backend №1). При удалении аккаунта phone очищается (unique освобождается).
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  /// Хэш телефона (HMAC) — антифрод-след после анонимизации аккаунта (ревю-qa №7).
  phoneHash       String?
  /// Google OAuth: вспомогательный вход без телефона (ревю-backend №1).
  email           String?   @unique
  googleId        String?   @unique
  role            UserRole  @default(CLIENT)
  trustTier       TrustTier @default(NEW)
  /// NULLABLE: заявка уходит сразу после OTP, имя дозаполняется после (ревю-ux №20).
  displayName     String?
  avatarUrl       String?
  /// Chat ID Telegram-бота после deep-link привязки — основной канал уведомлений.
  telegramChatId  String?   @unique
  locale          String    @default("ru") // ru | ky | en
  /// Заморозка (санкция страйков, ревю-backend №12): профиль виден, но мутации
  /// заказов/отзывов/кейсов запрещены (проверка в core). deletedAt = бан/удаление.
  frozenAt        DateTime?
  /// Настройки уведомлений: матрица категория×канал, тихие часы, «пауза 24 ч».
  /// Валидируется zod-схемой packages/core/notifications (ревю-backend №7).
  notificationPrefs Json?
  lastSeenAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  specialistProfile  SpecialistProfile?
  clientProfile      ClientProfile?
  orgMemberships     OrgMembership[]
  cases              Case[]
  caseCollaborations CaseCollaborator[]
  collections        Collection[]
  following          Follow[]           @relation("Follower")
  followers          Follow[]           @relation("Following")
  likes              Like[]
  saves              Save[]
  briefs             Brief[]
  briefResponses     BriefResponse[]
  chatParticipants   ChatParticipant[]
  messages           Message[]
  ordersAsClient     Order[]            @relation("OrderClient")
  ordersAsSpecialist Order[]            @relation("OrderSpecialist")
  checkpoints        OrderCheckpoint[]
  reviewsAuthored    Review[]           @relation("ReviewAuthor")
  reviewsReceived    Review[]           @relation("ReviewTarget")
  verifications      Verification[]
  reports            Report[]
  notifications      Notification[]
  entitlements       Entitlement[]
  pushSubscriptions  PushSubscription[]
  strikes            UserStrike[]
  devices            UserDevice[]
  sessions           Session[]

  @@index([role, createdAt])
  @@index([phoneHash])
}

// =============================================================================
// AUTH (M2): одноразовые коды и сессии
// =============================================================================

model OtpCode {
  id         String    @id @default(cuid())
  /// Телефон E.164; коды не привязаны к User — аккаунт создаётся после verify.
  phone      String
  /// SHA-256 хэш кода — сам код в БД не хранится.
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([phone, createdAt(sort: Desc)])
}

model Session {
  id         String    @id @default(cuid())
  /// SHA-256 хэш токена из httpOnly-cookie — сам токен в БД не хранится.
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

/// Специализации специалистов (spec §Роли). Мастеров-ремонтников НЕТ намеренно.
enum Specialization {
  REALTOR
  ARCHITECT
  INTERIOR_DESIGNER
  LANDSCAPE_DESIGNER
  DECORATOR_STAGER
  VISUALIZER_3D
  PHOTO_VIDEO
}

model SpecialistProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
  /// Латинский слаг публичного профиля /{slug}. Фаза 2: тот же слаг — кастомные домены.
  slug   String @unique
  /// NULLABLE: «пустой профиль» создаётся при verifyOtp, специализация и город
  /// заполняются в онбординг-мастере ПОСЛЕ регистрации (ревю-backend №2).
  /// Видимость в ленте/поиске требует заполненных specialization+city (core-правило).
  specialization Specialization?
  headline       String?
  bio            String?
  coverImageUrl  String?
  cityId         String?
  city           City?           @relation(fields: [cityId], references: [id])
  districtId     String?
  district       District?       @relation(fields: [districtId], references: [id])
  /// Вилка цен в СОМАХ (целые KGS, не minor units). USD — вычисляется по ExchangeRate.
  priceMin       Int?
  priceMax       Int?
  /// Единица измерения вилки — за м², за проект, за час (для честного сравнения).
  priceUnit      PriceUnit       @default(PER_PROJECT)
  acceptsOrders  Boolean         @default(true)
  /// Метка «работает в X» (решение 03/6): просто текст, org-механика — Фаза 1.5.
  worksAtLabel   String?
  /// Самозаявленное число закрытых сделок риелтора («47 сделок, 21 подтверждена»).
  declaredDealsCount Int?
  /// Денорм одобренной верификации личности (источник — Verification, M5).
  identityVerifiedAt DateTime?
  /// Счётчики витрины (инкрементально, точные данные — в PostHog/AnalyticsOutbox).
  viewsCount     Int             @default(0)
  /// Медиана первого ответа в заявках, мин. Считает фоновый джоб из данных чата;
  /// строка «скорость ответа» в сравнении откликов (ревю-backend №26, ревю-ux №18).
  medianResponseMinutes Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  styles             SpecialistStyle[]
  expertiseDistricts SpecialistDistrict[]
  reviewAggregate    ReviewAggregate?
  boostCampaigns     BoostCampaign[]

  @@index([specialization, cityId, acceptsOrders])
  @@index([cityId])
}

/// Районы экспертизы риелтора (docs/05 §5.4) — по образцу SpecialistStyle.
model SpecialistDistrict {
  specialistProfileId String
  specialistProfile   SpecialistProfile @relation(fields: [specialistProfileId], references: [id])
  districtId          String
  district            District          @relation(fields: [districtId], references: [id])

  createdAt DateTime @default(now())

  @@id([specialistProfileId, districtId])
  @@index([districtId])
}

enum PriceUnit {
  PER_M2
  PER_PROJECT
  PER_HOUR
}

model ClientProfile {
  id     String  @id @default(cuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id])
  cityId String?
  city   City?   @relation(fields: [cityId], references: [id])
  /// Денормализация «N завершённых заказов» — лёгкая репутация клиента.
  completedOrdersCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Web Push подписка PWA (ревю-backend №7). endpoint уникален глобально.
model PushSubscription {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  endpoint String  @unique
  p256dh   String
  auth     String
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Журнал страйков = и счётчик санкций, и audit (ревю-backend №12).
/// 1/2 страйк → предупреждение/заморозка (User.frozenAt), 3 — блокировка.
model UserStrike {
  id               String  @id @default(cuid())
  userId           String
  user             User    @relation(fields: [userId], references: [id])
  reasonCode       String
  /// Ссылка на разбор модерации, породивший страйк (мягкая, без FK).
  moderationItemId String?
  comment          String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Минимальный след устройств для антифрод-правила device_cluster (ревю-backend №13).
/// PII-гигиена: только хэши IP/UA; ретеншн 180 дней (воркер очистки).
model UserDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  ipHash      String
  uaHash      String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, ipHash, uaHash])
  @@index([ipHash])
}

// =============================================================================
// ОРГАНИЗАЦИИ (агентства) — в БД с первого дня, UI MVP: метка «работает в X»
// =============================================================================

model Organization {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  logoUrl String?
  cityId  String?
  city    City?   @relation(fields: [cityId], references: [id])
  /// Бейдж «юрлицо/патент подтверждены» (через Verification kind=ORG_CLAIM/BUSINESS).
  isVerified Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships   OrgMembership[]
  cases         Case[]
  verifications Verification[]
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

/// Статусы членства (ревю-backend №10, ревю-qa №9): DECLARED показывается сразу
/// с тултипом «указано специалистом, не проверено»; история LEFT/REJECTED хранится
/// («работал в X (2024–2026)», споры «он у нас не работал»).
enum OrgMembershipStatus {
  DECLARED  // специалист указал сам
  CONFIRMED // подтверждено owner'ом организации (после claim)
  LEFT      // ушёл (история сохраняется)
  REJECTED  // owner отклонил
}

model OrgMembership {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  role           OrgRole             @default(MEMBER)
  status         OrgMembershipStatus @default(DECLARED)
  /// Период работы — публичная история занятости.
  startedAt      DateTime?
  endedAt        DateTime?
  /// userId owner'а, подтвердившего/отклонившего (мягкая ссылка).
  confirmedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Повторное трудоустройство после LEFT легально → полного unique нет.
  // «Не более одного АКТИВНОГО членства на пару» — partial unique index
  // (raw-миграция): UNIQUE (organizationId, userId) WHERE status IN ('DECLARED','CONFIRMED').
  @@index([organizationId, status])
  @@index([userId, status])
}

// =============================================================================
// ГЕОГРАФИЯ И ТАКСОНОМИИ
// =============================================================================

model City {
  id     String  @id @default(cuid())
  slug   String  @unique
  nameRu String
  nameKy String?
  nameEn String?
  /// ISO 3166-1 alpha-2. Сейчас KG; Фаза 2 — KZ, UZ без миграции схемы.
  country   String @default("KG")
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  districts          District[]
  specialistProfiles SpecialistProfile[]
  clientProfiles     ClientProfile[]
  organizations      Organization[]
  cases              Case[]
  briefs             Brief[]
}

model District {
  id     String  @id @default(cuid())
  cityId String
  city   City    @relation(fields: [cityId], references: [id])
  slug   String
  nameRu String
  nameKy String?
  nameEn String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  specialistProfiles  SpecialistProfile[]
  cases               Case[]
  specialistDistricts SpecialistDistrict[]
  briefs              Brief[]

  @@unique([cityId, slug])
}

/// Стили (минимализм, неоклассика, лофт…) — курируемый справочник, фильтр ленты.
model Style {
  id        String  @id @default(cuid())
  slug      String  @unique
  nameRu    String
  nameKy    String?
  nameEn    String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseStyles       CaseStyle[]
  specialistStyles SpecialistStyle[]
}

/// Категории кейсов (квартира, дом, коммерция, ландшафт…) — курируемый справочник.
model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  nameRu    String
  nameKy    String?
  nameEn    String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases Case[]
}

/// Свободные теги (нормализуются приложением: lowercase, транслит-слаг).
model Tag {
  id     String @id @default(cuid())
  slug   String @unique
  nameRu String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseTags CaseTag[]
}

model SpecialistStyle {
  specialistProfileId String
  specialistProfile   SpecialistProfile @relation(fields: [specialistProfileId], references: [id])
  styleId             String
  style               Style             @relation(fields: [styleId], references: [id])

  createdAt DateTime @default(now())

  @@id([specialistProfileId, styleId])
  @@index([styleId])
}

// =============================================================================
// КЕЙСЫ — главная единица контента
// =============================================================================

enum CaseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

/// Realtor-first (docs/05 §5): тип сделки кейса-сделки.
enum DealType {
  SALE
  RENT_OUT
  BUY_ASSIST
  RENT_ASSIST
}

/// Видимость цены сделки. Точная цена при RANGE/HIDDEN не отдаётся никогда (03/§13).
enum DealPriceVisibility {
  EXACT
  RANGE
  HIDDEN
}

/// Роль автора в проекте — честная атрибуция вклада.
enum CaseAuthorRole {
  FULL_PROJECT
  DESIGN_ONLY
  AUTHOR_SUPERVISION
  VISUALIZATION
  PHOTOGRAPHY
  STAGING
  REALTOR_LISTING
  OTHER
}

model Case {
  id          String         @id @default(cuid())
  authorId    String
  author      User           @relation(fields: [authorId], references: [id])
  slug        String         @unique
  title       String
  description String?
  status      CaseStatus     @default(DRAFT)
  authorRole  CaseAuthorRole @default(FULL_PROJECT)
  /// Кейс от имени агентства — B2B-витрина Фазы 1.5 (ревю-backend №10, «закладываем сейчас»).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id])
  cityId      String?
  city        City?          @relation(fields: [cityId], references: [id])
  districtId  String?
  district    District?      @relation(fields: [districtId], references: [id])
  /// Площадь, м² (дробная: 45.5 м²).
  areaM2      Decimal?       @db.Decimal(9, 2)
  /// Бюджет проекта вилкой, СОМЫ (целые KGS). null = «бюджет не указан».
  budgetMin   Int?
  budgetMax   Int?
  /// Срок выполнения проекта в днях.
  srokDays    Int?
  /// Чекбокс «у меня есть права на публикацию этих фото» — обязателен для публикации.
  hasPublishRights Boolean @default(false)
  publishedAt DateTime?
  rejectReason String?
  /// REQUEST_CHANGES модерации: структурированные правки {imageIds[], reasonCodes[]}
  /// (ревю-backend №18, ревю-qa №13).
  changeRequests Json?
  /// Автоскрытие модерацией (≥3 жалоб abuse_nsfw) БЕЗ смены status — восстановление
  /// после dismiss возвращает как было (ревю-backend №22). Публичные выборки
  /// фильтруют hiddenAt: null тем же Prisma-extension, что и deletedAt.
  hiddenAt    DateTime?
  /// Денормализованная обложка карточки ленты/OG — убирает N+1 (ревю-backend №24а).
  coverImageId String?   @unique
  coverImage   CaseImage? @relation("CaseCover", fields: [coverImageId], references: [id])
  /// Денормализованные счётчики для карточек ленты (пересчёт — фоновым джобом).
  likesCount  Int @default(0)
  savesCount  Int @default(0)
  viewsCount  Int @default(0)

  // ——— Кейс-сделка (Realtor-first, docs/05 §5; все поля nullable — аддитивно) ———
  dealType            DealType?
  /// Тип объекта — единый словарь с брифами (матчинг поручение↔сделка).
  propertyType        BriefObjectType?
  /// Точная цена (EXACT), сомы; для аренды — в месяц.
  dealPriceSom        Int?
  /// Вилка (RANGE) — публикуется только диапазон.
  dealPriceMinSom     Int?
  dealPriceMaxSom     Int?
  dealPriceVisibility DealPriceVisibility @default(RANGE)
  /// Дней от публикации до задатка/договора; только SALE/RENT_OUT.
  daysOnMarket        Int?
  /// Денорм «подтверждено клиентом». Источник истины — confirmedOrderId ниже.
  dealConfirmedAt     DateTime?
  /// Завершённый Order, подтвердивший сделку. @unique = один заказ — один бейдж
  /// (иначе один заказ накручивал бы все кейсы). Мягкая ссылка, FK не нужен.
  confirmedOrderId    String?   @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  images          CaseImage[]
  collaborators   CaseCollaborator[]
  styles          CaseStyle[]
  tags            CaseTag[]
  likes           Like[]
  saves           Save[]
  collectionItems CollectionItem[]
  boostCampaigns  BoostCampaign[]
  briefResponseLinks BriefResponseCase[]
  threadsAbout    ChatThread[]     @relation("ThreadAboutCase")

  // Лента: published-кейсы по свежести; фильтры по городу/категории.
  @@index([dealType, status, publishedAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@index([cityId, status, publishedAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([authorId, status])
  @@index([organizationId])
}

model CaseImage {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id])
  /// Ключ файла в хранилище (pathname в Vercel Blob / относительный путь в dev).
  /// EXIF/GPS срезаны при перекодировании sharp — приватность жилья.
  storageKey String
  /// Варианты рендеров: { "400": {avif, webp}, "800": {...}, "1600": {...} }.
  variants   Json
  blurhash   String
  width      Int
  height     Int
  sortOrder  Int     @default(0)
  caption    String?
  /// Пары «до/после»: обе картинки делят beforeAfterGroup, у «до» isBeforeImage=true.
  isBeforeImage    Boolean @default(false)
  beforeAfterGroup String?
  /// Перцептивный хэш — антидубликаты внутри платформы (краденые портфолио).
  phash      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  annotations     CaseImageAnnotation[]
  collectionItems CollectionItem[]
  coverOf         Case?                 @relation("CaseCover")

  @@index([caseId, sortOrder])
  @@index([phash])
}

/// Метки на фото с комментариями — core-функция спеки §Кейсы (ревю-backend №5).
/// Координаты — доли 0..1 от ширины/высоты (не пиксели: варианты рендеров разные).
model CaseImageAnnotation {
  id          String    @id @default(cuid())
  caseImageId String
  caseImage   CaseImage @relation(fields: [caseImageId], references: [id])
  x           Decimal   @db.Decimal(6, 5)
  y           Decimal   @db.Decimal(6, 5)
  /// Текст метки — публичное поле, проходит автоскрытие контактов.
  text        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseImageId])
}

enum CollaboratorStatus {
  INVITED
  ACCEPTED
  DECLINED
  REVOKED // соавтор вышел после ACCEPTED — кейс уходит из его профиля (ревю-qa №12)
}

/// Команда проекта: совместные кейсы — рейтинг/витрина растут у всех подтвердивших.
/// Лимит Free считает только authorId — соавторство слот не тратит (ревю-qa №12).
model CaseCollaborator {
  id     String         @id @default(cuid())
  caseId String
  case   Case           @relation(fields: [caseId], references: [id])
  userId String
  user   User           @relation(fields: [userId], references: [id])
  role   CaseAuthorRole @default(OTHER)
  /// Кейс появляется в профиле коллеги только после ACCEPTED.
  status CollaboratorStatus @default(INVITED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, userId])
  @@index([userId, status])
}

model CaseStyle {
  caseId  String
  case    Case   @relation(fields: [caseId], references: [id])
  styleId String
  style   Style  @relation(fields: [styleId], references: [id])

  createdAt DateTime @default(now())

  @@id([caseId, styleId])
  @@index([styleId])
}

model CaseTag {
  caseId String
  case   Case   @relation(fields: [caseId], references: [id])
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id])

  createdAt DateTime @default(now())

  @@id([caseId, tagId])
  @@index([tagId])
}

// =============================================================================
// КОЛЛЕКЦИИ, ПОДПИСКИ, РЕАКЦИИ
// =============================================================================

model Collection {
  id        String  @id @default(cuid())
  ownerId   String
  owner     User    @relation(fields: [ownerId], references: [id])
  title     String
  isPrivate Boolean @default(false)
  /// Коллекция по умолчанию «Сохранённое» — сюда мигрируют гостевые сохранения
  /// (ревю-qa №11). Не более одной на владельца — partial unique (raw-миграция):
  /// UNIQUE (ownerId) WHERE isDefault.
  isDefault Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items  CollectionItem[]
  briefs Brief[]

  @@index([ownerId])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id])
  caseId       String
  case         Case       @relation(fields: [caseId], references: [id])
  /// Опционально — конкретное фото кейса, которое сохранил пользователь (с FK,
  /// чтобы «сохранённое фото» не протухало молча — ревю-backend №25).
  caseImageId  String?
  caseImage    CaseImage? @relation(fields: [caseImageId], references: [id])
  sortOrder    Int        @default(0)

  createdAt DateTime @default(now())

  @@unique([collectionId, caseId])
  @@index([caseId])
  @@index([caseImageId])
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  follower    User   @relation("Follower", fields: [followerId], references: [id])
  followingId String
  following   User   @relation("Following", fields: [followingId], references: [id])

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Like {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, caseId])
  @@index([caseId])
}

/// Быстрое «сохранить» (момент радости). Раскладка по коллекциям — CollectionItem.
model Save {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, caseId])
  @@index([caseId])
}

// =============================================================================
// БРИФЫ И ОТКЛИКИ
// =============================================================================

enum BriefStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum BriefObjectType {
  APARTMENT
  HOUSE
  COMMERCIAL
  OFFICE
  LAND
  NEW_BUILD
  OTHER
}

model Brief {
  id       String      @id @default(cuid())
  clientId String
  client   User        @relation(fields: [clientId], references: [id])
  status   BriefStatus @default(DRAFT)
  title    String
  /// Описание задачи. Публичный текст проходит автоскрытие контактов (решение 03/7).
  description String?
  objectType  BriefObjectType @default(APARTMENT)
  specialization Specialization?
  cityId      String?
  city        City?           @relation(fields: [cityId], references: [id])
  /// Район — ключевой контекст риелторского брифа (M4.5).
  districtId  String?
  district    District?       @relation(fields: [districtId], references: [id])
  areaM2      Decimal?        @db.Decimal(9, 2)
  /// Бюджет вилкой, СОМЫ (целые KGS).
  budgetMin   Int?
  budgetMax   Int?
  timelineDays Int?
  /// Референсы — коллекция-мудборд клиента. Стили брифа для матчинга выводятся
  /// из стилей сохранённых кейсов этой коллекции (решение — ревю-backend №26).
  referenceCollectionId String?
  referenceCollection   Collection? @relation(fields: [referenceCollectionId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  responses BriefResponse[]
  threads   ChatThread[]
  orders    Order[]

  @@index([status, cityId, createdAt(sort: Desc)])
  @@index([clientId])
}

/// Единый словарь статусов (ревю-ux №3): SENT → VIEWED → SHORTLISTED →
/// ACCEPTED / DECLINED / HIDDEN. «Выбран другой» — производное от закрытия брифа.
enum BriefResponseStatus {
  SENT
  VIEWED
  SHORTLISTED
  DECLINED
  HIDDEN // клиент скрыл с причиной — антисигнал для матчинга (ревю-backend №23)
  ACCEPTED
}

model BriefResponse {
  id           String              @id @default(cuid())
  briefId      String
  brief        Brief               @relation(fields: [briefId], references: [id])
  specialistId String
  specialist   User                @relation(fields: [specialistId], references: [id])
  status       BriefResponseStatus @default(SENT)
  message      String
  /// Предварительная оценка, СОМЫ (целые KGS).
  priceEstimate Int?
  /// Клиент открыл отклик (статус «просмотрен» у специалиста).
  viewedAt     DateTime?
  /// Причина скрытия (status=HIDDEN) — антисигнал для матчинга.
  hiddenReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases BriefResponseCase[]

  @@unique([briefId, specialistId])
  // createdAt в индексе — месячный счёт лимита Free (ревю-backend №24в).
  @@index([specialistId, createdAt])
}

/// Кейсы, приложенные к отклику (1–3) — главный визуальный аргумент сравнения
/// (ревю-backend №16, ревю-ux №1). Валидация «published и принадлежат специалисту» — core.
model BriefResponseCase {
  briefResponseId String
  briefResponse   BriefResponse @relation(fields: [briefResponseId], references: [id])
  caseId          String
  case            Case          @relation(fields: [caseId], references: [id])
  sortOrder       Int           @default(0)

  createdAt DateTime @default(now())

  @@id([briefResponseId, caseId])
  @@index([caseId])
}

// =============================================================================
// ЧАТ
// =============================================================================

model ChatThread {
  id      String  @id @default(cuid())
  /// Контекст возникновения треда (опционально): бриф.
  briefId String?
  brief   Brief?  @relation(fields: [briefId], references: [id])
  /// Контекст заявки (M4): кейс, с которого пришёл клиент, и тема первого сообщения.
  aboutCaseId String?
  aboutCase   Case?   @relation("ThreadAboutCase", fields: [aboutCaseId], references: [id])
  subject     String?
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ChatParticipant[]
  messages     Message[]
  orders       Order[]

  @@index([lastMessageAt(sort: Desc)])
}

model ChatParticipant {
  id       String     @id @default(cuid())
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id])
  userId   String
  user     User       @relation(fields: [userId], references: [id])
  lastReadAt DateTime?
  /// Mute треда (настройки уведомлений Б2, ревю-backend №7). null = не заглушён.
  mutedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([threadId, userId])
  @@index([userId])
}

enum MessageKind {
  TEXT
  IMAGE
  FILE
}

model Message {
  id       String      @id @default(cuid())
  threadId String
  thread   ChatThread  @relation(fields: [threadId], references: [id])
  senderId String
  sender   User        @relation(fields: [senderId], references: [id])
  kind     MessageKind @default(TEXT)
  text     String?
  /// Для IMAGE/FILE: ключ в R2 + метаданные ({name, size, mime, width, height, blurhash}).
  fileKey  String?
  fileMeta Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([threadId, createdAt])
}

// =============================================================================
// ЗАКАЗ — state machine (см. docs/11-data-model.md §2)
// discussion → agreed → in_progress → delivered → completed (+ cancelled, disputed)
// =============================================================================

enum OrderState {
  DISCUSSION
  AGREED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

model Order {
  id           String     @id @default(cuid())
  clientId     String
  client       User       @relation("OrderClient", fields: [clientId], references: [id])
  specialistId String
  specialist   User       @relation("OrderSpecialist", fields: [specialistId], references: [id])
  briefId      String?
  brief        Brief?     @relation(fields: [briefId], references: [id])
  threadId     String?
  thread       ChatThread? @relation(fields: [threadId], references: [id])
  state        OrderState @default(DISCUSSION)
  title        String
  description  String?
  /// Договорные условия: вилка суммы (СОМЫ, целые KGS) + ориентир срока.
  /// Информационные поля — платформа НЕ проводит платежи и НЕ берёт
  /// комиссию/проценты (жёсткий принцип продукта). (ревю-backend №19)
  agreedAmountMin Int?
  agreedAmountMax Int?
  timelineDays    Int?

  // Взаимные подтверждения договорённости (антифрод: заказ = 2 верифицированных телефона).
  clientAgreedAt     DateTime?
  specialistAgreedAt DateTime?

  // Сдача-приёмка: «сдан» предлагает специалист, подтверждает клиент.
  deliveredAt   DateTime?
  /// Клиент подтвердил приёмку вручную. При авто-подтверждении остаётся null.
  confirmedAt   DateTime?
  /// Дедлайн авто-подтверждения (deliveredAt + N дней, N=7 конфиг); воркер завершает
  /// заказ, ставит autoConfirmed=true и шлёт уведомления T-48/T-24.
  autoConfirmAt DateTime?
  /// Завершён авто-подтверждением воркера — понижает вес отзыва, видимая пометка
  /// «подтверждено автоматически» (ревю-backend №9, ревю-qa №3).
  autoConfirmed Boolean @default(false)

  completedAt  DateTime?
  cancelledAt  DateTime?
  /// userId инициатора отмены (мягкая ссылка, без FK — валидируется приложением).
  cancelledById String?
  cancelReason  String?
  disputeOpenedAt DateTime?
  disputeReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkpoints OrderCheckpoint[]
  events      OrderEvent[]
  review      Review?

  @@index([clientId, state])
  @@index([specialistId, state])
  @@index([state, autoConfirmAt])
  // Velocity-антифрод: частые заказы между одной и той же парой аккаунтов.
  @@index([clientId, specialistId, createdAt])
}

/// Журнал переходов заказа (ревю-backend №8): timeline в UI, «кто инициировал»,
/// лимит возвратов на доработку (≤3), хронология для арбитража. Пишется в той же
/// транзакции, что переход. Append-only.
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  fromState OrderState?
  toState   OrderState
  /// userId инициатора (мягкая ссылка). null = система (авто-подтверждение) или
  /// арбитраж (различаются по reason).
  byUserId  String?
  reason    String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/// Чек-поинты хода работ с фотофиксацией — повышают вес будущего отзыва.
model OrderCheckpoint {
  id          String @id @default(cuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id])
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  title       String
  note        String?
  /// Массив фото: [{storageKey, variants, blurhash, width, height}] — EXIF срезан.
  photos      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, createdAt])
}

// =============================================================================
// РЕПУТАЦИЯ
// =============================================================================

/// Отзыв — ТОЛЬКО по завершённому заказу (state=COMPLETED), автор = клиент заказа.
/// Специалист клиента в MVP не оценивает. Инварианты — в packages/core
/// (см. docs/11-data-model.md §3).
model Review {
  id           String @id @default(cuid())
  orderId      String @unique // один отзыв на заказ — жёсткий констрейнт БД
  order        Order  @relation(fields: [orderId], references: [id])
  authorId     String
  author       User   @relation("ReviewAuthor", fields: [authorId], references: [id])
  specialistId String
  specialist   User   @relation("ReviewTarget", fields: [specialistId], references: [id])

  // Подшкалы 1–5.
  scoreQuality       Int @db.SmallInt
  scoreTimeline      Int @db.SmallInt
  scoreCommunication Int @db.SmallInt
  scoreBudget        Int @db.SmallInt

  text   String?
  /// Фото результата: [{storageKey, variants, blurhash, width, height}].
  photos Json?
  /// Вес отзыва в рейтинге (0..1): base 0.7 + верификация клиента + чек-поинты
  /// − штраф авто-подтверждения (формула — core/reputation, см. 11-data-model §3).
  weight Decimal @default(1.0) @db.Decimal(3, 2)
  /// Публичный ответ специалиста на отзыв (один; ревю-backend №17).
  replyText String?
  repliedAt DateTime?
  /// Редактирование автором в окне 72 ч (ревю-qa №19); дальше — через поддержку.
  editedAt  DateTime?
  /// Заказ завершён решением арбитража — пометка для аналитики/антифрода (ревю-qa №20).
  viaArbitration Boolean @default(false)
  /// Скрыт модерацией (спор/фрод) — не участвует в агрегатах.
  hiddenAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([specialistId, createdAt(sort: Desc)])
}

/// Денормализованные агрегаты рейтинга профиля — читается лентой/витриной,
/// пересчитывается транзакционно при создании/скрытии/редактировании отзыва.
model ReviewAggregate {
  id                  String            @id @default(cuid())
  specialistProfileId String            @unique
  specialistProfile   SpecialistProfile @relation(fields: [specialistProfileId], references: [id])

  reviewsCount       Int     @default(0)
  avgOverall         Decimal @default(0) @db.Decimal(3, 2)
  avgQuality         Decimal @default(0) @db.Decimal(3, 2)
  avgTimeline        Decimal @default(0) @db.Decimal(3, 2)
  avgCommunication   Decimal @default(0) @db.Decimal(3, 2)
  avgBudget          Decimal @default(0) @db.Decimal(3, 2)
  completedOrdersCount Int   @default(0)
  /// % повторных клиентов (0–100) — публичная честная метрика.
  repeatClientsPct   Decimal @default(0) @db.Decimal(5, 2)
  // ——— Realtor-first агрегаты (docs/05 §5.4) ———
  /// Сделки, подтверждённые клиентом через Order.
  confirmedDealsCount Int  @default(0)
  /// Кейсы-сделки в профиле (published).
  dealCasesCount      Int  @default(0)
  /// Медиана daysOnMarket по подтверждённым; null при < 5 (порог честности).
  medianDaysOnMarket  Int?
  recalculatedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([avgOverall(sort: Desc)])
}

// =============================================================================
// ВЕРИФИКАЦИЯ, ЖАЛОБЫ, МОДЕРАЦИЯ
// =============================================================================

enum VerificationKind {
  IDENTITY  // личность
  BUSINESS  // юрлицо / патент
  ORG_CLAIM // заявка на владение организацией (ревю-backend №11, ревю-qa №17)
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Verification {
  id     String             @id @default(cuid())
  userId String
  user   User               @relation(fields: [userId], references: [id])
  kind   VerificationKind
  status VerificationStatus @default(PENDING)
  /// Для kind=ORG_CLAIM: организация, на которую претендует заявитель.
  /// Одобрение → OrgMembership(role=OWNER, status=CONFIRMED) + Organization.isVerified.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  /// Документы в приватном бакете R2: [{storageKey, name}]. Никогда не публично.
  /// МИМО общего пайплайна изображений: без CDN/вариантов/pHash (ревю-backend №28).
  documents    Json
  /// userId модератора (мягкая ссылка, без FK).
  reviewedById String?
  reviewedAt   DateTime?
  rejectReason String?
  /// Автоудаление документов из R2 через 30 дней после решения (воркер);
  /// комплаенс-событие verification_docs_purged (ревю-qa №18).
  docsPurgedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind, status])
  @@index([status, createdAt])
}

enum ReportTargetType {
  CASE
  CASE_IMAGE // жалоба на конкретное фото кейса (ревю-backend №22)
  REVIEW
  USER
  BRIEF
  MESSAGE
  COLLECTION
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReportReason {
  STOLEN_CONTENT
  SPAM
  CONTACTS_IN_PUBLIC
  OFFENSIVE
  FAKE              // включая «misleading» из Б3 (маппинг зафиксирован)
  FALSE_AFFILIATION // «не работает в этой организации» (ревю-qa №16)
  FRAUD             // маршрутизируется в антифрод-очередь
  OTHER
}

model Report {
  id         String @id @default(cuid())
  /// NULLABLE: гость может пожаловаться без регистрации (решение по ревю-backend №14,
  /// ревю-qa №15) — тогда reporterAnonId + rate limit по IP; дедуп по anonId+IP.
  reporterId String?
  reporter   User?  @relation(fields: [reporterId], references: [id])
  /// Анонимный id гостя (cookie) — антиспам и дедуп гостевых жалоб.
  reporterAnonId String?
  targetType ReportTargetType
  /// Полиморфная ссылка: id сущности targetType (FK нет — валидируется приложением).
  targetId   String
  reason     ReportReason
  comment    String?
  status     ReportStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

enum ModerationEntityType {
  CASE
  REVIEW
  USER
  BRIEF
  MESSAGE
  ORDER
  ORGANIZATION
  VERIFICATION
}

enum ModerationReason {
  NEW_USER_PREMOD    // trust-tier NEW: премодерация первых кейсов
  PHASH_DUPLICATE    // совпадение перцептивного хэша
  VELOCITY_ANOMALY   // аномалия частоты заказов/отзывов
  REPORTED           // жалобы пользователей
  CONTACT_LEAK       // контакты в публичном контенте
  DISPUTE            // арбитраж спора по заказу
  MANUAL             // ручная постановка админом
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED // «вернуть на доработку»: кейс → DRAFT + changeRequests (ревю №18/№13)
  ESCALATED
}

/// Единая очередь модерации — полиморфно по (entityType, entityId).
model ModerationItem {
  id         String               @id @default(cuid())
  entityType ModerationEntityType
  entityId   String
  reason     ModerationReason
  status     ModerationStatus     @default(PENDING)
  /// Контекст для модератора: id жалоб, phash-совпадения, метрики аномалии.
  payload    Json?
  /// После REQUEST_CHANGES повторный submit возвращается тому же assignee.
  assigneeId String?
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([entityType, entityId])
}

/// «Пара не дубликат» — гасит повторные pHash-алерты по той же паре изображений
/// (ревю-backend №27). Пара нормализована приложением: imageIdA < imageIdB.
model PhashDismissal {
  id            String  @id @default(cuid())
  imageIdA      String
  imageIdB      String
  /// userId модератора (мягкая ссылка).
  dismissedById String?

  createdAt DateTime @default(now())

  @@unique([imageIdA, imageIdB])
}

/// Неизменяемый журнал действий модераторов/админов (ревю-qa №14): каждое решение,
/// каждый просмотр документов верификации. Append-only: в коде нет update/delete;
/// пишется в транзакции с действием. actorId без FK — журнал переживает аккаунты.
model AuditLog {
  id         BigInt  @id @default(autoincrement())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  payload    Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// =============================================================================
// УВЕДОМЛЕНИЯ
// In-app центр = источник истины; Telegram и PWA push — каналы доставки.
// =============================================================================

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  /// Код типа из реестра packages/core/notifications (НЕ enum БД: словарь Б1 —
  /// 30+ типов и растёт; тип → категория → канал маппится в core; новые типы —
  /// без миграции. Решение по ревю-backend №6).
  type   String
  title  String
  body   String?
  /// Deep-link данные: {caseId | orderId | threadId | url ...}.
  payload Json?
  readAt  DateTime?
  /// Отметки доставки по каналам (null = не отправлялось/не доставлено).
  telegramSentAt DateTime?
  pushSentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, readAt, createdAt(sort: Desc)])
}

// =============================================================================
// МОНЕТИЗАЦИЯ: планы, entitlements, промокоды, буст
// Никаких кредитных/процентных механик. На старте PRO — вручную/промокодами.
// =============================================================================

enum PlanCode {
  FREE
  PRO
}

model Plan {
  id   String   @id @default(cuid())
  code PlanCode @unique
  name String
  /// Цена, СОМЫ в месяц (целые KGS). 0 = бесплатно.
  priceMonthly Int @default(0)
  // Лимиты; null = безлимит (PRO). Лимит — предикат ПУБЛИКАЦИИ, не хранения:
  // при PRO→Free опубликованное сверх лимита остаётся (grandfathering, ревю-qa №2).
  maxPublishedCases        Int? // Free = 5
  maxBriefResponsesMonthly Int? // Free = 10 (решение по ревю-qa №23)
  hasAnalytics     Boolean @default(false)
  hasPriorityFeed  Boolean @default(false)
  hasShowcaseMode  Boolean @default(false)
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entitlements Entitlement[]
  promoCodes   PromoCode[]
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum EntitlementSource {
  DEFAULT // Free по умолчанию
  MANUAL  // активирован админом
  PROMO   // промокод
  PAYMENT // Фаза 1.5+: PaymentProvider (Mbank/O!Деньги/…)
}

model Entitlement {
  id     String            @id @default(cuid())
  userId String
  user   User              @relation(fields: [userId], references: [id])
  planId String
  plan   Plan              @relation(fields: [planId], references: [id])
  status EntitlementStatus @default(ACTIVE)
  source EntitlementSource @default(DEFAULT)
  startsAt  DateTime  @default(now())
  expiresAt DateTime? // null = бессрочно (Free)
  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // один промокод — один раз на пользователя (NULL у MANUAL/PAYMENT не конфликтует)
  @@unique([userId, promoCodeId])
  @@index([userId, status])
  @@index([status, expiresAt])
}

model PromoCode {
  id     String @id @default(cuid())
  code   String @unique
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])
  /// Срок действия выданного PRO в днях.
  durationDays   Int
  maxRedemptions Int  @default(1)
  redeemedCount  Int  @default(0)
  expiresAt      DateTime?
  /// userId админа-создателя (мягкая ссылка).
  createdById    String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entitlements Entitlement[]
}

enum BoostStatus {
  SCHEDULED
  ACTIVE
  FINISHED
  CANCELLED
}

/// Платный буст кейса или профиля. В выдаче всегда с пометкой «продвижение».
model BoostCampaign {
  id     String      @id @default(cuid())
  status BoostStatus @default(SCHEDULED)
  // Цель — ровно одна из двух (XOR валидируется приложением).
  caseId String?
  case   Case?       @relation(fields: [caseId], references: [id])
  specialistProfileId String?
  specialistProfile   SpecialistProfile? @relation(fields: [specialistProfileId], references: [id])
  startsAt DateTime
  endsAt   DateTime
  /// Стоимость кампании, СОМЫ (целые KGS). Фиксированная цена — не аукцион, не проценты.
  priceSom Int
  impressionsCount Int @default(0)
  clicksCount      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt, endsAt])
}

// =============================================================================
// СЕРВИСНОЕ: курсы валют, событийная аналитика
// =============================================================================

/// Курс НБКР, обновляется раз в сутки воркером. Используется только для
/// ОТОБРАЖЕНИЯ цен в USD — все хранимые суммы остаются в сомах.
/// Фаза 2 (KZT/UZS): просто новые пары валют, схема не меняется.
model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String   @default("KGS") // ISO 4217
  quoteCurrency String // "USD", Фаза 2: "KZT", "UZS"
  rate          Decimal  @db.Decimal(14, 6)
  rateDate      DateTime @db.Date
  source        String   @default("NBKR")

  createdAt DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, rateDate])
}

/// Transactional outbox для событийной аналитики (PostHog) — событие пишется
/// в одной транзакции с доменным изменением, воркер доставляет и помечает.
model AnalyticsOutbox {
  id        BigInt   @id @default(autoincrement())
  eventName String
  /// Актор события (userId или анонимный id гостя) — без FK, событие переживает пользователя.
  actorId   String?
  /// Свойства события; имена событий — apps/web/src/server/track.ts (вызовы track/trackSafe).
  props     Json
  occurredAt  DateTime @default(now())
  deliveredAt DateTime?

  @@index([deliveredAt, occurredAt])
  @@index([eventName, occurredAt])
  // окно активности дашборда (where occurredAt >= …)
  @@index([occurredAt])
}
