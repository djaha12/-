# ATELIER — переменные окружения (пример). Копируйте в Vercel Project Settings → Environment
# Variables. Локально Prisma читает packages/db/.env; секреты в репозиторий не коммитим.
# NODE_ENV НЕ задавать вручную — Vercel ставит сам (на preview тоже 'production';
# окружение различать через VERCEL_ENV).

# ── База данных (обязательно) ────────────────────────────────────────────────
# DATABASE_URL — ПУЛ-строка транзакционного пулера (serverless открывает много коннектов).
#   Supabase: postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   Neon:     postgresql://...-pooler.<region>.aws.neon.tech/db?sslmode=require
DATABASE_URL="postgresql://user:pass@HOST:6543/db?pgbouncer=true&connection_limit=1"
# DIRECT_URL — ПРЯМОЕ session-mode соединение (:5432) для prisma migrate deploy / seed.
#   Через pgBouncer миграции виснут на advisory-lock. В dev = тот же URL, что DATABASE_URL.
DIRECT_URL="postgresql://user:pass@HOST:5432/db?sslmode=require"

# ── Адрес сайта (обязательно для SEO/OG) ─────────────────────────────────────
# SITE_URL — канонический адрес: canonical, OG, sitemap, JSON-LD. Рантайм (без пересборки).
#   Если не задан — фолбэк на https://$VERCEL_PROJECT_PRODUCTION_URL (домен Vercel).
SITE_URL="https://atelier.example"

# ── Хранилище фото (обязательно в проде) ─────────────────────────────────────
# BLOB_READ_WRITE_TOKEN — авто-инжектится Vercel после Storage → Create Blob Store →
#   Connect Project. Без него загрузка фото в проде падает (ФС лямбды read-only).
#   Локально можно не задавать: dev пишет в .data/uploads.
BLOB_READ_WRITE_TOKEN=""

# ── Крон и антиспам (обязательно в проде) ────────────────────────────────────
# CRON_SECRET — Vercel Cron сам шлёт как Authorization: Bearer при вызове крона.
#   Генерация: openssl rand -hex 32. Без него /api/cron/auto-confirm отвечает 401 (fail-closed).
CRON_SECRET=""
# ANON_REPORT_SALT — соль HMAC для анонимных жалоб. openssl rand -hex 32.
#   Без него в проде жалобы гостей отключены (fail-closed против деанонимизации).
ANON_REPORT_SALT=""

# ── Вход по OTP ──────────────────────────────────────────────────────────────
# TELEGRAM_GATEWAY_TOKEN — боевая доставка кода через Telegram Gateway
#   (gateway.telegram.org). Задан → код уходит в Telegram по номеру, на экране не
#   показывается. Не задан → демо-режим (см. OTP_DEV_MODE). Для номеров без Telegram
#   нужен SMS-фолбэк (отдельный провайдер, Фаза 1.5).
TELEGRAM_GATEWAY_TOKEN=""
# OTP_DEV_MODE=1 — демо-вход: код на экране для тест-номеров +9967000XXXXX.
#   ТОЛЬКО preview/dev. На публичном Production НЕ задавать (гейт по VERCEL_ENV).
OTP_DEV_MODE=""
# SEED_DEMO=0 — не засеивать демо-контент (фейковые специалисты/кейсы) в прод-БД.
SEED_DEMO=""

# ── Telegram-уведомления (опционально; без токена — деградация в in-app) ──────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
NEXT_PUBLIC_TELEGRAM_BOT=""
# TELEGRAM_LINK_SECRET="" # если не задан — берётся CRON_SECRET
